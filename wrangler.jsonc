{
  // Grill Shuffle on Cloudflare: one Worker for /api/*, Workers Static Assets for the Vite build, D1 for progress.
  // Local:  npm run db:migrate:local && npm run preview   (wrangler dev on :8797 with a local D1 in .wrangler/)
  // Deploy: npm run deploy (CI does it on every push to main). Production: https://grillshuffle.thebuilder.work
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grill-shuffle",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "grillshuffle.thebuilder.work", "custom_domain": true }],
  "workers_dev": false,
  // not wrangler's default 8787: other local projects listen there. Vite proxies /api here (vite.config.js).
  "dev": { "port": 8797 },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grill-shuffle",
      "database_id": "25ccd2c2-595c-4c22-b13d-62e6e349bb08",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // 00:05 UTC: pre-build today's and tomorrow's daily puzzle into D1 (worker/index.js prebuildDaily).
  // Local test: npx wrangler dev --test-scheduled, then GET /cdn-cgi/handler/scheduled?cron=5+0+*+*+*
  "triggers": { "crons": ["5 0 * * *"] }
  // Building a generated / daily puzzle runs the solver (cached in D1 after). The account is on Workers Paid:
  // 30 s CPU per request / cron run by default, far above a build (~150 ms). Raise only if needed (max 300000):
  // "limits": { "cpu_ms": 60000 }
  // R2 (audio banks, GLB, share images) and Durable Objects (realtime race) are not used yet: see docs/CLOUDFLARE.md.
}
