{
  "name": "grill-shuffle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grill Shuffle: Food Sort & Match Puzzle. Deterministic puzzle engine, solver, level generator and Three.js renderer on Cloudflare Workers.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-content.js && vite build && node scripts/build-sw.js",
    "preview": "npm run build && wrangler dev",
    "check": "node scripts/check.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:sim": "node --test \"tests/sim/*.test.js\"",
    "test:solver": "node --test \"tests/solver/*.test.js\"",
    "test:worker": "node --test \"tests/worker/*.test.js\"",
    "fuzz": "node scripts/fuzz.js",
    "solve": "node scripts/solve.js",
    "validate:levels": "node scripts/validate-levels.js",
    "generate:levels": "node scripts/generate-levels.js",
    "bench:solver": "node solver/benchmark.js",
    "next-issue": "node scripts/next-issue.js",
    "shot": "node scripts/shot.js",
    "test:e2e": "node scripts/e2e.js",
    "shot:match": "node scripts/shot-match.js",
    "ci": "npm run check && npm test && npm run validate:levels && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply grill-shuffle --local",
    "deploy": "npm run ci && wrangler deploy",
    "visual": "node scripts/visual.js",
    "visual:accept": "node scripts/visual-accept.js"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
